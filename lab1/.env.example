# Optional. Set in PowerShell: $env:GITHUB_TOKEN = '...'
# No token is required for normal anonymous public requests.
GITHUB_TOKEN=
# Optional alternate local data directory (default: lab1/data).
OWASP_DATA_DIR=
# Optional Langfuse Cloud (never commit .env or paste secret keys into the chat).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Full query/prompt/answer/doc export is off by default. Opt-in uses best-effort masking.
LANGFUSE_CAPTURE_TEXTS=false
